{
  "name": "dsh-backup-migrator",
  "version": "0.3.1",
  "description": "Backup and migrate DeepSeek Harness plugin environments via GitHub: one command exports the installed plugin manifest, plugin configs and locally-developed plugin sources into a git repository, and another restores everything on a new machine (VSCode-settings-sync style). Ships an optional built-in scheduler that backs up automatically at a configurable interval.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/load-test.mjs && node test/aux-migration.mjs && node test/schedule-test.mjs",
    "verify": "node scripts/portability.mjs --health /api/dsh-backup-migrator/probe --stability 15",
    "verify:full": "node scripts/portability.mjs --health /api/dsh-backup-migrator/probe --stability 30",
    "verify:quick": "node scripts/portability.mjs --skip-audit --stability 5 --health /api/dsh-backup-migrator/probe"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "migrate",
    "sync",
    "scheduled",
    "github",
    "插件备份",
    "迁移",
    "定时备份"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengjy01/dsh-backup-migrator"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  }
}
